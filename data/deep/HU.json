  "itineraries": {
    "hot": [
      {
        "zh": "布達佩斯定點深度",
        "days": "4–5 天",
        "note": "城堡山與漁人堡、國會大廈、猶太區與大市場,傍晚泡塞切尼或蓋勒特溫泉、夜遊多瑙河。台灣多一次轉機可達,是中歐自由行的熱門起點。"
      },
      {
        "zh": "布達佩斯＋維也納＋布拉迪斯拉發",
        "days": "6–7 天",
        "note": "多瑙河三都以火車一至三小時互通,可從布達佩斯搭快船或火車到維也納,順道停斯洛伐克首都。適合想一次多國的旅客。"
      },
      {
        "zh": "布達佩斯＋巴拉頓湖",
        "days": "4–5 天",
        "note": "首都行程後搭火車到巴拉頓湖,夏季戲水、蒂豪尼半島散步、品北岸白酒。步調悠閒,適合家庭。"
      },
      {
        "zh": "匈牙利東北:艾格爾—托卡伊—霍爾托巴吉",
        "days": "5–6 天",
        "note": "艾格爾城堡與「公牛血」紅酒、托卡伊貴腐甜酒、霍爾托巴吉草原的牧人表演與灰牛。自駕較彈性,適合愛酒與草原風光的旅客。"
      },
      {
        "zh": "多瑙河灣區一日圈",
        "days": "4–5 天",
        "note": "以布達佩斯為基地,一日遊聖安德烈藝術小鎮、維謝格拉德要塞與埃斯泰爾戈姆大教堂。適合不想拉車的旅客。"
      }
    ],
    "niche": [
      {
        "zh": "佩奇與南部",
        "note": "擁有早期基督教墓室世界遺產的大學城佩奇,搭配維拉尼紅酒產區與錫克洛什城堡,遊客較少。"
      },
      {
        "zh": "霍爾托巴吉國家公園深度",
        "note": "歐洲最大的天然草原「普斯塔」,看牧馬表演、灰牛與大鴇,春秋為賞鳥高峰,住宿與交通須先安排。"
      },
      {
        "zh": "厄爾謝格與西部溫泉小鎮",
        "note": "與奧地利、斯洛維尼亞交界的丘陵林區,搭配海維茲溫泉湖與布克溫泉,適合慢節奏療養行。"
      }
    ]
