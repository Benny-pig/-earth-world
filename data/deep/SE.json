  "recommended": [
    {
      "zh": "仲夏節前後的斯德哥爾摩與群島",
      "note": "六月下旬日照近乎不落,可搭船跳島、參加仲夏柱慶典,是體驗瑞典夏天的最佳時機。"
    },
    {
      "zh": "冬季的瑞典拉普蘭",
      "note": "十二月至三月前往阿比斯庫、尤卡斯亞爾維看極光、住冰旅館、體驗狗拉雪橇與馴鹿文化。"
    },
    {
      "zh": "八月哥特蘭島的中世紀週",
      "note": "維斯比古城牆內市集、騎士比武與扮裝遊行連辦一週,適合家庭同遊。"
    }
  ],
