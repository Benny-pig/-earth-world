  "itineraries": {
    "hot": [
      {
        "zh": "斯德哥爾摩＋老城＋群島",
        "days": "5–6 天",
        "note": "老城區、瓦薩博物館、市政廳與皇宮安排三天,再搭渡輪到群島住一晚。台灣多轉機一次可達,適合第一次到北歐、想輕鬆走一座首都的旅客。"
      },
      {
        "zh": "斯德哥爾摩＋哥特蘭島",
        "days": "6–7 天",
        "note": "首都行程接飛機或夜航渡輪到維斯比,環中世紀城牆散步、租單車遊島、看拉威爾石灰岩海蝕柱。古城加海島,步調悠閒。"
      },
      {
        "zh": "瑞典拉普蘭極光之旅",
        "days": "6–7 天",
        "note": "經斯德哥爾摩轉機到基魯納,住冰旅館、追極光、體驗狗拉雪橇與薩米馴鹿營。十二月至三月為旺季,保暖裝備與行程須提早訂。"
      },
      {
        "zh": "斯德哥爾摩＋馬爾默＋哥本哈根跨國",
        "days": "7–8 天",
        "note": "搭高鐵經跨海大橋串聯瑞典第三大城馬爾默與丹麥首都,一趟收兩國三城。適合想一次多看的旅客。"
      },
      {
        "zh": "南部大城環線:哥德堡—馬爾默—隆德",
        "days": "5–6 天",
        "note": "哥德堡的海鮮與群島、馬爾默的旋轉大樓、隆德的大學古城,鐵路串聯方便,人潮比首都少。"
      }
    ],
    "niche": [
      {
        "zh": "國王小徑健行(Kungsleden)",
        "note": "拉普蘭山區的長距離步道,夏季七至九月可分段健行、住山屋。天氣多變、蚊蚋多,須有裝備與體力。"
      },
      {
        "zh": "高海岸(Höga Kusten)世界遺產",
        "note": "波的尼亞灣沿岸因冰後地殼回彈而持續抬升的獨特海岸,適合開車兼健行,大眾運輸稀疏建議自駕。"
      },
      {
        "zh": "達拉納省的湖區與達拉木馬",
        "note": "手繪達拉木馬的發源地,保留最濃的瑞典鄉村風情與仲夏傳統。班次少,自駕較彈性。"
      }
    ]
  },
