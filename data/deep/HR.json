  "itineraries": {
    "hot": [
      {
        "zh": "杜布羅夫尼克—斯普利特—普利特維采—札格雷布",
        "days": "8–10 天",
        "note": "由南向北串聯環城牆古城、戴克里先宮、瀑布湖群與首都,沿途可跳島赫瓦爾或科爾丘拉。台灣多經伊斯坦堡、杜哈或法蘭克福轉機,是最經典的縱走。"
      },
      {
        "zh": "伊斯特拉半島",
        "days": "5–6 天",
        "note": "以羅維尼為基地走普拉競技場、波雷奇教堂與內陸山城莫托溫、格羅日尼揚,配松露與葡萄酒。適合租車慢遊。"
      },
      {
        "zh": "達爾馬提亞跳島",
        "days": "7–8 天",
        "note": "斯普利特出發,搭渡輪或遊艇串聯赫瓦爾、維斯與科爾丘拉,最後進杜布羅夫尼克。夏季船班密、住宿要早訂。"
      },
      {
        "zh": "札格雷布＋普利特維采＋札達爾＋克爾卡",
        "days": "5–6 天",
        "note": "首都文化、兩座瀑布國家公園與札達爾的海管風琴,行程緊湊但拉車不長。"
      },
      {
        "zh": "杜布羅夫尼克＋蒙特內哥羅一日",
        "days": "4–5 天",
        "note": "以杜布羅夫尼克為據點,一天南下科托爾峽灣,一天走城牆與洛克魯姆島。"
      }
    ],
    "niche": [
