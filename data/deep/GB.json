  "itineraries": {
    "hot": [
      {
        "zh": "英格蘭經典:倫敦—溫莎—巴斯—巨石陣—科茲窩—牛津",
        "days": "7–10 天",
        "note": "第一次到英國的標準路線,倫敦看大英博物館、西敏寺與塔橋,再往西看羅馬浴場城市巴斯、史前巨石陣、蜂蜜色石屋的科茲窩村莊與大學城牛津。多數景點有火車或一日遊巴士可達,科茲窩自駕最方便,適合想一次看足城市與英式鄉村的人。"
      },
      {
        "zh": "蘇格蘭高地與斯開島:愛丁堡—格倫科—尼斯湖—斯開島—因弗尼斯",
        "days": "6–9 天",
        "note": "從愛丁堡舊城與城堡出發,進高地看格倫科峽谷、尼斯湖、格倫芬南高架橋(哈利波特霍格華茲特快車場景)與斯開島的仙女池與老人岩。冬季日照極短、山路難行,建議 5 到 9 月來且租車,適合愛壯闊山景與威士忌的人。"
      },
      {
        "zh": "NC500 蘇格蘭北海岸環線:因弗尼斯—東岸—約翰岬角—西北高地—阿普爾克羅斯",
        "days": "5–7 天",
        "note": "繞蘇格蘭最北端一圈約 830 公里,有空曠海岸、白沙灘、單線道山路與零星的城堡與蒸餾廠,是近年爆紅的自駕與露營車(campervan)路線。建議逆時針走、旺季住宿與營位一定要先訂,單線道的會車禮儀要先做功課。"
      },
      {
        "zh": "湖區與英格蘭北部:曼徹斯特—湖區—約克—惠特比",
        "days": "5–7 天",
        "note": "從曼徹斯特或利物浦進,在湖區健行、搭汽船遊溫德米爾湖與造訪碧雅翠絲波特的彼得兔故居,再往東到城牆古城約克與海邊的惠特比。湖區山路窄、停車位少,自駕要有心理準備,適合愛健行與文學場景的人。"
      },
      {
        "zh": "威爾斯環遊:卡地夫—布雷肯比肯斯—彭布羅克郡海岸—史諾多尼亞—康威",
        "days": "7–10 天",
        "note": "從首府卡地夫出發,走布雷肯比肯斯山區、彭布羅克郡的海岸步道與城堡、史諾多尼亞國家公園(可搭齒軌火車上威爾斯最高峰)與地中海風的波特梅里恩村。多為鄉間小路,自駕或參加小團最順,適合想避開英格蘭人潮、走山海路線的人。"
      }
    ],
    "niche": [
      {
        "zh": "康瓦爾與英格蘭西南角:聖艾夫斯—蘭茲角—伊甸園計畫—提恩塔哲",
        "note": "英格蘭最西南端的漁村、藝術小鎮、亞瑟王傳說的提恩塔哲城堡與伊甸園計畫的巨型溫室,夏天海水湛藍近乎地中海。距倫敦拉車 5 小時以上、旺季塞車嚴重,建議搭火車到彭贊斯或紐奎再租車。"
      },
      {
        "zh": "哈利波特場景巡禮:倫敦國王十字—牛津—阿尼克城堡—格倫芬南高架橋",
        "note": "從倫敦的九又四分之三月台、牛津基督教會學院的餐廳與迴廊,一路到英格蘭北部阿尼克城堡的飛行課場地與蘇格蘭的高架橋,適合影迷。景點分散在英格蘭與蘇格蘭兩端,要安排跨區交通,城堡開放季節要先查。"
      },
      {
        "zh": "史前與羅馬遺跡:艾夫伯里巨石圈—哈德良長城—巴斯",
        "note": "艾夫伯里的巨石圈可以走進去觸摸、遊客遠少於巨石陣,哈德良長城則是羅馬帝國北界的健行路線。景點多在鄉間、大眾運輸稀疏,長城段更需要自駕加健行裝備。"
      }
    ]
  },
