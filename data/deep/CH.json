  "itineraries": {
    "hot": [
      {
        "zh": "少女峰地區＋琉森",
        "days": "6–7 天",
        "note": "因特拉肯進出,少女峰車站、雪朗峰、格林德瓦與勞特布龍嫩瀑布谷,再加琉森廊橋與鐵力士山。買瑞士旅行通行證划算,是第一次到瑞士、想一次看齊雪山的自由行首選。"
      },
      {
        "zh": "冰河列車景觀縱貫:策馬特—聖莫里茲",
        "days": "7–8 天",
        "note": "從馬特洪峰腳下的策馬特搭冰河列車翻越阿爾卑斯到聖莫里茲,沿途布里格、庫爾與伯連納線。適合愛搭火車看窗景、不想天天換飯店的旅客。"
      },
      {
        "zh": "瑞士精華大環線",
        "days": "8–10 天",
        "note": "蘇黎世、琉森、少女峰、蒙特勒西庸城堡、日內瓦、伯恩,火車串成一圈。適合假期充足、城市與雪山都不想錯過的旅客。"
      },
      {
        "zh": "義語區提契諾",
        "days": "5–6 天",
        "note": "盧加諾、洛卡諾與貝林佐納三座古堡,棕櫚與湖濱像到了義大利,搭聖哥達基線隧道從北部一小時多可達。適合想避開人潮、喜歡湖光的旅客。"
      },
      {
        "zh": "蘇黎世＋萊茵瀑布",
        "days": "4–5 天",
        "note": "蘇黎世舊城與湖濱、歐洲水量最大的萊茵瀑布、施泰因暖鎮的彩繪屋。停留天數短、想輕鬆玩瑞士北部時適合。"
      }
    ],
