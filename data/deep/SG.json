  "itineraries": {
    "hot": [
      {
        "zh": "新加坡經典市區",
        "days": "3–4 天",
        "note": "濱海灣、聖淘沙、牛車水與小印度、植物園與夜間動物園。台灣有多家航空直飛約四個半小時,適合週末小旅行或轉機停留。"
      },
      {
        "zh": "新加坡親子遊",
        "days": "4–5 天",
        "note": "以聖淘沙環球影城、SEA 海洋館、河川生態園與夜間動物園為主,搭配濱海灣花園,行程輕鬆、交通方便。"
      },
      {
        "zh": "新馬雙城",
        "days": "5–6 天",
        "note": "新加坡進出,搭巴士或火車到新山樂高樂園,再北上麻六甲看古城,一趟走兩國。"
      },
      {
        "zh": "新加坡＋民丹島",
        "days": "5–6 天",
        "note": "市區三天後搭渡輪到印尼民丹島度假村住兩晚,結合都市與海島。"
      },
      {
        "zh": "美食購物深度遊",
        "days": "4 天",
        "note": "跟著小販中心與米其林攤位吃遍全島,搭配烏節路、加東與哈芝巷選物。"
      }
    ],
    "niche": [
      {
        "zh": "南部離島與聖約翰島",
        "note": "從濱海南碼頭搭船到聖約翰島、龜嶼,健行與野餐,遊客稀少。"
      },
      {
        "zh": "麥里芝樹梯步道",
        "note": "走吊橋與雨林步道找長尾獼猴與松鼠猴,清晨前往較涼爽。"
      },
      {
        "zh": "烏敏島單車行",
