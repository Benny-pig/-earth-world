  "itineraries": {
    "hot": [
      {
        "zh": "黃金圈＋雷克雅維克",
        "days": "4–5 天",
        "note": "辛格韋德利、蓋錫爾、古佛斯一日走完,加上藍湖與首都的哈爾格林姆教堂、彩色老城。冰島航空或北歐轉機可達,適合第一次來、天數有限的旅客。"
      },
      {
        "zh": "南岸經典:瀑布、黑沙灘、冰河湖",
        "days": "5–6 天",
        "note": "沿一號公路東行,看塞里雅蘭與斯科加瀑布、雷尼斯黑沙灘、傑古沙龍冰河湖與鑽石沙灘,冬季加藍冰洞。租車自駕,路況單純。"
      },
      {
        "zh": "環島公路一圈",
        "days": "8–10 天",
        "note": "逆時針走完全島:南岸瀑布、東部峽灣、米湖地熱區、北部胡薩維克賞鯨、西部斯奈山半島。夏季永晝適合,行李輕、住宿沿線預訂。"
      },
      {
        "zh": "冬季極光短程",
        "days": "4–5 天",
        "note": "以雷克雅維克為基地,白天走黃金圈或南岸一日團,晚上追極光,行有餘力進藍冰洞。適合怕開雪地的旅客。"
      },
      {
        "zh": "斯奈山半島＋西部",
        "days": "4–5 天",
        "note": "被稱為「冰島縮影」的半島,教會山、熔岩原、海崖與漁村,離首都近、人潮少。適合想避開南岸車陣的旅客。"
      }
    ],
    "niche": [
      {
        "zh": "西峽灣(Westfjords)",
        "note": "人跡罕至的西北角,丁堅地瀑布、拉泰拉海鸚崖與紅沙灘。道路多碎石、旺季外服務有限,建議夏季自駕。"
      },
      {
        "zh": "高地內陸(Landmannalaugar 與 Þórsmörk)",
        "note": "只在盛夏開放、需四驅車涉水的火山高地,彩色流紋岩山與「勞加維格」健行路線。"
      },
      {
        "zh": "維斯特曼納群島",
        "note": "搭渡輪到海上的赫馬島,看一九七三年火山噴發遺跡與夏季數十萬隻海鸚,島小步行即可遊。"
      }
    ]
  },
