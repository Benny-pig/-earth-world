  "code": "GR",
  "itineraries": {
    "hot": [
      {
        "zh": "雅典與基克拉澤斯跳島:雅典—米克諾斯—帕羅斯—納克索斯—聖托里尼",
        "days": "10–12 天",
        "note": "希臘自由行的黃金組合,先在雅典看衛城與衛城博物館,再搭渡輪跳島:米克諾斯的白牆風車與夜生活、納克索斯的古蹟與長沙灘、帕羅斯的漁村,最後收在聖托里尼看火山口與伊亞夕陽。跳島要抓好渡輪班表、旺季船票與住宿早訂,適合第一次來希臘的人。"
      },
      {
        "zh": "聖托里尼與米克諾斯機加酒:雙島精華",
        "days": "5–7 天",
        "note": "天數有限就直攻兩座最有名的島,聖托里尼的懸崖小鎮、火山健行與紅沙灘,米克諾斯的小威尼斯與提洛島(Delos)遺跡一日遊。兩島間有高速船約 2 到 3 小時,或各自從雅典搭國內線,適合蜜月與拍照取向的旅客。"
      },
      {
        "zh": "希臘本島環線:雅典—德爾菲—梅提歐拉—納夫普利歐—邁錫尼",
        "days": "7–9 天",
        "note": "租車走本島,看德爾菲的阿波羅神諭遺址、天空之城梅提歐拉的懸崖修道院,再進伯羅奔尼撒看邁錫尼、埃皮達魯斯劇場與威尼斯風港城納夫普利歐。全程幾乎都要開車、山路多,適合重古蹟與歷史、不想只待海島的人。"
      },
      {
        "zh": "克里特島環島:哈尼亞—雷西姆農—伊拉克利翁—克諾索斯—薩馬利亞峽谷",
        "days": "6–8 天",
        "note": "希臘最大島,有威尼斯與鄂圖曼風的舊城哈尼亞與雷西姆農、米諾斯文明的克諾索斯宮殿、粉紅沙灘 Elafonisi 與 16 公里長的薩馬利亞峽谷健行。島很大、東西橫向拉車久,建議租車並選 1 到 2 個定點,適合想一島玩深的人。"
      },
      {
        "zh": "愛奧尼亞海諸島:科孚島—凱法利尼亞—札金索斯(沉船灣)",
        "days": "7–10 天",
        "note": "希臘西側、靠義大利這一側的綠色島群,有科孚舊城的威尼斯要塞、凱法利尼亞的地下湖與札金索斯的沉船灣(Navagio),海水是招牌的螢光藍。島間渡輪班次比基克拉澤斯少,通常搭配義大利或從雅典轉國內線,適合重海灘與跳島的人。"
      }
    ],
    "niche": [
      {
        "zh": "馬尼半島與尼奧堡:伯羅奔尼撒最南端的石塔村",
        "note": "尼奧堡(Monemvasia)是藏在巨岩後的中世紀石城,馬尼半島則滿是防禦石塔樓與荒涼海岸,遊客稀少、氣氛蒼勁。大眾運輸幾乎到不了,一定要自駕,住宿選擇也有限。"
      },
      {
        "zh": "薩羅尼克灣近郊跳島:海德拉—波羅斯—埃伊納",
        "note": "從雅典港口一小時內可達的小島,海德拉島全島禁行汽機車、只有驢子與石板路,適合只有一兩天也想出海的人。當天來回或住一晚都行,夏季週末雅典人也會湧入。"
      },
      {
        "zh": "北希臘與哈爾基季基:塞薩洛尼基—哈爾基季基三叉半島",
        "note": "第二大城塞薩洛尼基有拜占庭教堂與濃厚的鄂圖曼、猶太歷史,往南的哈爾基季基三根「手指」有希臘人自己最愛的海灘(阿索斯聖山僅開放男性、需事先申請)。從雅典要拉車或搭國內線,適合想避開海島人潮的旅客。"
      }
    ]
  },
