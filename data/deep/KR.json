  "itineraries": {
    "hot": [
      {
        "zh": "首爾雙城:首爾—釜山(KTX)",
        "days": "6–7 天",
        "note": "首爾景福宮韓服體驗、弘大明洞購物、汗蒸幕,搭 KTX 兩個多小時到釜山看海雲台、甘川洞文化村與札嘎其市場。適合第一次到韓國、想一次玩到都會與海港的自由行。"
      },
      {
        "zh": "首爾與近郊:首爾—南怡島—小法國村—愛寶樂園",
        "days": "5–6 天",
        "note": "市區宮殿、美食與購物為主,再排一到兩天近郊,冬天加滑雪、秋天賞楓。行程不用拉太多車,適合親子與情侶的輕鬆行。"
      },
      {
        "zh": "濟州島環島:濟州市—西歸浦—牛島",
        "days": "5–6 天",
        "note": "租車走海岸公路,城山日出峰、牛島、綠茶園與正房瀑布,配黑豬肉與海女海鮮。步調悠閒像度假,適合想開車看海、住民宿的旅客。"
      },
      {
        "zh": "江原道山海線:首爾—江陵—束草—雪嶽山",
        "days": "5–6 天",
        "note": "搭 KTX 到江陵在鏡浦海邊喝海景咖啡,再到束草吃辣魚湯、爬雪嶽山賞楓或看雪。適合愛健行、想避開首爾人潮的自然派。"
      },
      {
        "zh": "慶州安東歷史線:釜山—慶州—安東",
        "days": "4–5 天",
        "note": "慶州佛國寺、石窟庵與大陵苑古墳群,安東河回村看假面舞與韓屋聚落,像走進新羅與朝鮮時代。適合對歷史文化有興趣、想放慢腳步的旅客。"
      }
    ],
    "niche": [
      {
        "zh": "南海岸閑麗水道:麗水—統營—閑山島",
        "note": "夜間海上纜車與百里島嶼海景,統營東皮郎壁畫村與生蠔料理,是韓國人自己的度假祕境。大眾運輸較弱,建議自駕或包車,週末當地遊客也不少。"
      },
      {
        "zh": "全州韓屋村與全羅美食",
        "note": "全州拌飯、韓定食與韓紙工藝,住一晚傳統韓屋、穿韓服逛巷弄,是公認的美食之都。假日人潮擁擠,平日前往體驗較好,可順遊內藏山賞楓。"
      },
      {
        "zh": "非武裝地帶 DMZ 與坡州",
        "note": "從首爾當天往返,參觀第三隧道、都羅山瞭望台,近距離感受南北分斷的現實。板門店共同警備區須事先透過官方行程預約、帶護照,當天無法臨時報名。"
      }
    ]
  }
}
