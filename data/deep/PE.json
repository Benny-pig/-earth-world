  "recommended": [
    {
      "zh": "五到九月的旱季庫斯科與聖谷",
      "note": "高原少雨、步道穩定,適合走印加古道、參觀聖谷市集與鹽田,行前需在庫斯科停留一兩天適應高度。"
    },
    {
      "zh": "六到八月的科爾卡峽谷",
      "note": "阿雷基帕出發的深谷,清晨在十字架觀景台看安地斯神鷲乘氣流盤旋,沿途有溫泉與梯田村落。"
    },
    {
      "zh": "五到十月的亞馬遜叢林",
      "note": "從馬爾多納多港或伊基托斯進入,水位較低、步道好走,可看粉紅河豚、猴群與金剛鸚鵡黏土崖。"
    }
  ],
