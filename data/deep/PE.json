  "itineraries": {
    "hot": [
      {
        "zh": "庫斯科＋馬丘比丘",
        "days": "5 天",
        "note": "台灣多經美國轉利馬再飛庫斯科。先在庫斯科適應高度、逛聖谷,搭觀光火車到熱水鎮,隔天一早登馬丘比丘。"
      },
      {
        "zh": "秘魯經典南環",
        "days": "10–12 天",
        "note": "利馬、帕拉卡斯與納斯卡線、阿雷基帕與科爾卡峽谷、庫斯科與聖谷、的的喀喀湖普諾,巴士與國內線並用。"
      },
      {
        "zh": "利馬美食與周邊",
        "days": "3–4 天",
        "note": "適合轉機停留,吃遍檸檬醃生魚與名店,走米拉弗洛雷斯海崖、巴蘭科藝術區,一天到帕拉卡斯看鳥島。"
      },
      {
        "zh": "亞馬遜雨林生態",
        "days": "4 天",
        "note": "從馬爾多納多港轉船進生態旅館,安排夜間找凱門鱷、黏土崖賞鸚鵡與樹冠層吊橋。"
      },
      {
        "zh": "印加古道健行",
        "days": "4–5 天",
        "note": "經典四天路線需數月前抽名額,翻越死婦隘口,最後從太陽門走進馬丘比丘;體力有限可改走短版兩天。"
      }
    ],
    "niche": [
      {
        "zh": "瓦拉斯與白色山脈",
        "note": "布蘭卡山脈的高山湖泊與六千公尺雪峰,69 號湖與聖克魯茲環線是安地斯健行者的私房地。"
      },
      {
        "zh": "北部莫切金字塔之路",
        "note": "特魯希略與奇克拉約一帶的太陽月亮神廟、希潘王墓與昌昌泥城,遊客遠少於南部。"
      },
      {
        "zh": "亞馬遜源頭伊基托斯",
        "note": "無公路相連、只能搭飛機或船抵達的雨林大城,搭慢船深入保護區看巨睡蓮與河豚。"
      }
    ]
