  "recommended": [
    {
      "zh": "十一到二月的龍坡邦",
      "note": "涼季乾爽舒適,適合看清晨布施、爬普西山看夕陽、跳島到光西瀑布,湄公河遊船視野也最好。"
    },
    {
      "zh": "十到四月的四千美島",
      "note": "湄公河進入寮柬邊界後分岔成的河中群島,租單車看孔恩瀑布、找伊河海豚,步調極慢適合放空。"
    },
    {
      "zh": "十一到三月的川壙石缸平原",
      "note": "高原氣候涼、能見度佳,參觀一、二、三號缸群並看戰爭遺跡,需走已排雷的標示路徑。"
    }
  ],
