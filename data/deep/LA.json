  "itineraries": {
    "hot": [
      {
        "zh": "龍坡邦慢遊",
        "days": "4 天",
        "note": "台灣多經曼谷或河內轉機。逛古城寺廟、夜市與皇宮博物館,清晨看布施,一天到光西瀑布戲水、順訪帕烏洞。"
      },
      {
        "zh": "龍坡邦＋永珍",
        "days": "6 天",
        "note": "先玩龍坡邦,再搭中寮鐵路或國內線到永珍,看塔鑾、凱旋門與佛像公園,行程輕鬆。"
      },
      {
        "zh": "湄公河順流",
        "days": "5 天",
        "note": "從泰國會曬過境,搭兩天慢船經北本到龍坡邦,沿途停靠村落與帕烏洞,體驗河運生活。"
      },
      {
        "zh": "寮國南部環線",
        "days": "6–7 天",
        "note": "巴色進出,跑波羅芬高原咖啡與瀑布、瓦普廟遺址,再到四千美島找河豚看日落。"
      },
      {
        "zh": "川壙與石缸平原",
        "days": "4 天",
        "note": "從龍坡邦搭機或走山路到豐沙灣,看三處石缸群與越戰遺跡,可延伸到桑怒的洞穴基地。"
      }
    ],
    "niche": [
      {
        "zh": "南俄湖與孔羅洞",
        "note": "甘蒙省的七公里長河穿山洞,搭獨木舟摸黑穿越,結合森林步道與吊橋。"
      },
      {
        "zh": "北部山村健行",
        "note": "從烏多姆賽或琅南塔進入,住阿卡族與克木族村落,走原始林看野生長臂猿棲地。"
      },
      {
        "zh": "華潘省與抗戰洞穴",
        "note": "維恩賽洞窟群曾是巴特寮總部,可深入了解內戰時期的地下生活。"
      }
    ]
  },
