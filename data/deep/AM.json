  "itineraries": {
    "hot": [
      {
        "zh": "葉里溫與周邊",
        "days": "4 天",
        "note": "台灣多經杜哈、杜拜或莫斯科轉機。市區看共和廣場、種族滅絕紀念館與白蘭地廠,一天跑格加爾德、加尼與埃奇米亞津,一天到霍瑞維拉眺望亞拉拉特山。"
      },
      {
        "zh": "亞美尼亞修道院環線",
        "days": "7–8 天",
        "note": "葉里溫進出,串連賽凡湖、迪利然、哈格帕特與薩納因、塔特夫與阿雷尼酒鄉,多為包車或參團。"
      },
      {
        "zh": "亞美尼亞＋喬治亞雙國",
        "days": "10–12 天",
        "note": "葉里溫與第比利斯各進出一次,陸路經北部修道院與賽凡湖,兩地拉車約六小時。"
      },
      {
        "zh": "葡萄酒與美食",
        "days": "5 天",
        "note": "以葉里溫與阿雷尼為據點,參觀鳥洞(Areni-1)遺址與酒莊、學做 tolma 與 lavash,秋天遇採收季最佳。"
      },
      {
        "zh": "高加索健行(迪利然與南部)",
        "days": "6 天",
        "note": "走「跨高加索步道」迪利然段,搭配賽凡半島與塔特夫周邊的峽谷路線。"
      }
    ],
    "niche": [
      {
        "zh": "瓦約茨佐爾峽谷與岩鑿聚落",
        "note": "南部偏遠峽谷與岩洞村,少有旅遊團,適合自駕探訪。"
      },
      {
        "zh": "久姆里的重建與工藝",
        "note": "亞美尼亞第二大城,一九八八年地震重創後重建,黑凝灰岩老城與鐵匠、陶藝傳統值得停留。"
      },
      {
        "zh": "洛里峽谷雙修道院",
        "note": "哈格帕特與薩納因兩座世界遺產修道院隔谷相望,搭配阿拉維爾迪的鐵索橋與峽谷風光。"
      }
    ]
  },
