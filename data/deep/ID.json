  "itineraries": {
    "hot": [
      {
        "zh": "峇里島經典",
        "days": "5–7 天",
        "note": "烏布梯田與猴林、海神廟與烏魯瓦圖看日落與凱恰克舞、水明漾海灘,再跳一天藍夢島。台灣有直飛航班,適合第一次到印尼、想度假加文化的家庭與情侶。"
      },
      {
        "zh": "日惹文化雙遺產",
        "days": "4–5 天",
        "note": "婆羅浮屠日出、普蘭巴南印度教群廟、蘇丹王宮與銀器蠟染工坊,可加默拉皮火山吉普車。適合對佛教與印度教古蹟有興趣的旅客。"
      },
      {
        "zh": "峇里島＋科莫多跳島",
        "days": "8–10 天",
        "note": "峇里島玩幾天後飛納閩巴瑤,搭船看科莫多龍、粉紅沙灘與帕達爾島展望。適合想把度假與探險、浮潛結合的旅客。"
      },
      {
        "zh": "布羅莫與伊真火山",
        "days": "5–6 天",
        "note": "泗水進出,布羅莫看火山日出、伊真火山看藍色火焰與硫磺湖。需半夜摸黑健行,適合體力尚可、愛拍火山地景的旅客。"
      },
      {
        "zh": "雅加達＋萬隆",
        "days": "4–5 天",
        "note": "首都獨立廣場與老城區、萬隆的火山溫泉與暢貨中心,高鐵已通車。適合想看印尼都會與近郊生活的旅客。"
      }
    ],
    "niche": [
      {
        "zh": "蘇拉威西塔納托拉查",
        "note": "看懸崖墓葬、船形屋與繁複的喪禮儀式,七、八月喪禮季最盛。從望加錫拉車很久,路況顛簸,要有心理準備。"
      },
      {
        "zh": "西巴布亞四王群島潛水",
        "note": "公認全球珊瑚礁最豐富的海域之一,以船宿或民宿為主。費用高、地點偏遠,機位與船位務必提早很久預訂。"
      },
      {
        "zh": "蘇門答臘多巴湖與武吉拉旺",
        "note": "多巴湖中的沙摩西島有巴塔克文化,武吉拉旺可徒步找紅毛猩猩。城際車程長,全年多雨。"
      }
    ]
  },
