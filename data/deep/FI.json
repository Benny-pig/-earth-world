  "itineraries": {
    "hot": [
      {
        "zh": "赫爾辛基＋愛沙尼亞塔林",
        "days": "4–5 天",
        "note": "赫爾辛基的大教堂、岩石教堂、設計區與芬蘭堡安排兩天,搭快船當日往返塔林中世紀老城。航點多、行程輕鬆,適合第一次到芬蘭的旅客。"
      },
      {
        "zh": "羅瓦涅米極光與聖誕村",
        "days": "5–6 天",
        "note": "飛赫爾辛基轉機到羅瓦涅米,住玻璃屋追極光、坐哈士奇與馴鹿雪橇、逛聖誕老人村。十二月至三月旺季,行程與住宿要早訂。"
      },
      {
        "zh": "湖區木屋假期(薩翁林納—庫奧皮奧)",
        "days": "5–6 天",
        "note": "夏季租湖畔木屋,划船、桑拿、採莓,順遊奧拉溫林納城堡與庫奧皮奧的煙燻塔。步調悠閒,適合家庭與情侶。"
      },
      {
        "zh": "赫爾辛基＋斯德哥爾摩郵輪",
        "days": "5–6 天",
        "note": "搭波羅的海過夜郵輪往返瑞典首都,船上看群島風景,兩端各安排一至兩天。適合想同遊兩國又不想拉車的旅客。"
      }
    ],
    "niche": [
      {
        "zh": "庫薩莫與奧蘭卡國家公園",
        "note": "東部近俄羅斯邊界的原野,夏季走「熊之路」步道、秋季看色葉。班次稀疏,建議自駕或參加行程。"
      },
      {
        "zh": "奧蘭群島",
        "note": "位於芬蘭與瑞典之間、講瑞典語的自治群島,適合夏天騎單車跳島、看紅色花崗岩海岸。"
      },
      {
        "zh": "哈邁林納與芬蘭中部工藝小鎮",
        "note": "西貝流士故鄉、伊塔拉玻璃工廠與中世紀城堡,適合搭火車做一段慢節奏的文化小旅行。"
      }
    ]
  },
