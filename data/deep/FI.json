  "recommended": [
    {
      "zh": "六至八月的湖區",
      "note": "賽馬湖一帶日照極長,可租木屋、划獨木舟、蒸桑拿後跳湖,是芬蘭夏天的核心體驗。"
    },
    {
      "zh": "十二月至三月的拉普蘭",
      "note": "羅瓦涅米以北看極光、住玻璃屋、體驗馴鹿與哈士奇雪橇,並拜訪聖誕老人村。"
    },
    {
      "zh": "七月薩翁林納歌劇節",
      "note": "在奧拉溫林納城堡中庭聽歌劇,搭配湖區遊船,票與住宿要提前數月訂。"
    }
  ],
