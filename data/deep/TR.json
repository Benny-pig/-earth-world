  "itineraries": {
    "hot": [
      {
        "zh": "伊斯坦堡＋卡帕多奇亞",
        "days": "6–7 天",
        "note": "伊斯坦堡舊城三大古蹟、大巴札與博斯普魯斯遊船三天,飛內夫謝希爾看仙人煙囪、坐熱氣球、住洞穴旅館。台灣有直航或一次轉機,是第一次到土耳其的經典組合。"
      },
      {
        "zh": "土耳其西部經典環線",
        "days": "8–10 天",
        "note": "伊斯坦堡—恰納卡萊(特洛伊)—愛琴海的以弗所—棉堡—安塔利亞,一路遺跡加海岸。自駕或跟團,適合想一次看完古文明的旅客。"
      },
      {
        "zh": "伊斯坦堡定點深度",
        "days": "4–5 天",
        "note": "舊城古蹟、香料市場、加拉達塔與亞洲區的卡德柯伊,傍晚渡輪跨洲。航班多、飯店選擇廣,適合週末長假。"
      },
      {
        "zh": "卡帕多奇亞＋孔亞＋安塔利亞",
        "days": "7–8 天",
        "note": "從卡帕多奇亞南下孔亞看梅夫拉那與旋轉舞,再到地中海岸的安塔利亞古城與阿斯潘多斯劇場。適合想避開純西部路線的旅客。"
      },
      {
        "zh": "費特希耶藍色巡航",
        "days": "5–6 天",
        "note": "從費特希耶或馬爾馬里斯出發,搭木船在地中海沿岸跳島、浮潛、看沉城,行程悠閒。四至十月為航季。"
      }
    ],
    "niche": [
      {
        "zh": "土耳其東部:凡城與多烏拜亞澤特",
        "note": "凡湖、阿克達瑪島的亞美尼亞教堂與伊薩克帕夏宮。距離遠、班次少,建議搭國內線再自駕或包車。"
      },
      {
        "zh": "尼姆魯特山日出",
        "note": "東南部山頂的巨大石雕頭像陵墓,清晨看日出最佳,通常由卡赫塔或阿德亞曼安排接送。"
      },
      {
        "zh": "黑海山區:里澤與艾德爾高地",
        "note": "多雨蒼翠的茶園與雲霧繚繞的高山牧場(yayla),蘇美拉懸崖修道院是亮點,夏季前往、注意路況。"
      }
    ]
  },
