  "code": "AU",
  "itineraries": {
    "hot": [
      {
        "zh": "東岸精華:雪梨—烏魯魯—凱恩斯(大堡礁)",
        "days": "8–12 天",
        "note": "天數不多但想一次看足的組合,有雪梨的歌劇院、港灣大橋與邦代海灘,飛內陸看烏魯魯(艾爾斯岩)的日出日落,再飛凱恩斯出海浮潛大堡礁、進丹翠雨林。城市間全靠國內線,適合第一次來澳洲的人。"
      },
      {
        "zh": "雪梨—墨爾本與大洋路:澳洲東南",
        "days": "7–10 天",
        "note": "雪梨玩兩三天後飛墨爾本,以墨爾本為基地走大洋路(Great Ocean Road),看十二使徒岩、洛恩海岸與奧特威雨林,回程可繞內陸的格蘭屏。大洋路建議自駕、至少兩天一夜不要當天來回,適合愛海岸公路與咖啡文化的人。"
      },
      {
        "zh": "昆士蘭陽光帶:布里斯本—黃金海岸—聖靈群島—凱恩斯",
        "days": "8–12 天",
        "note": "沿昆士蘭海岸北上,有黃金海岸的主題樂園與衝浪、聖靈群島(Whitsundays)的白天堂沙灘與出海跳島、凱恩斯的大堡礁與雨林。段與段之間可搭國內線跳過長途,適合家庭與海島度假取向。"
      },
      {
        "zh": "紅色中心:愛麗斯泉—國王峽谷—卡塔丘塔—烏魯魯",
        "days": "4–6 天",
        "note": "從愛麗斯泉租車或跟團走內陸環線,有國王峽谷的環壁健行、卡塔丘塔(奧加斯)的風之谷、烏魯魯的環岩步道與夜裡的「田野之光」燈光裝置。日夜溫差大、夏季酷熱,建議 4 到 9 月來,適合想深入澳洲內陸與原住民文化的人。"
      },
      {
        "zh": "塔斯馬尼亞環島:荷巴特—搖籃山—酒杯灣—火焰灣—亞瑟港",
        "days": "7–10 天",
        "note": "從荷巴特租車繞全島一圈,有搖籃山國家公園健行、菲欣納半島的酒杯灣、火焰灣的橘紅礁石與流放犯監獄遺址亞瑟港,再回荷巴特逛 MONA 美術館與週末 Salamanca 市集。路程不長但彎多,適合愛健行、美食與清涼氣候的人。"
      }
    ],
    "niche": [
      {
        "zh": "西澳海岸:伯斯—瑪格麗特河—珊瑚灣—尼加洛礁—艾克斯茅斯",
        "note": "從伯斯往北自駕,有瑪格麗特河的酒莊與衝浪、尼加洛礁(Ningaloo)可從沙灘直接下水浮潛,3 到 8 月還能與鯨鯊同游。距離極長、油站與補給點稀疏,要規劃 12 天以上並注意行車疲勞。"
      },
      {
        "zh": "頂端地帶:達爾文—卡卡杜國家公園—李奇菲爾德—凱瑟琳峽谷",
        "note": "熱帶北領地的濕地與岩畫,卡卡杜看鱷魚、原住民岩石藝術與瀑布,乾季 5 到 10 月才適合前往。雨季道路淹水封閉,部分區域要 4x4,並隨時留意鹹水鱷警示。"
      },
      {
        "zh": "袋鼠島與南澳:阿德雷德—芭羅莎谷—袋鼠島—石灰岩海岸",
        "note": "阿德雷德近郊的芭羅莎谷酒鄉,加上以野生動物聞名的袋鼠島(海獅、無尾熊、神奇岩石)。2020 年野火後生態仍在恢復,上島要搭渡輪、島上距離遠需自駕。"
