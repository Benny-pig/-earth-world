  "itineraries": {
    "hot": [
      {
        "zh": "挪威縮影:奧斯陸—卑爾根—松恩峽灣",
        "days": "6–7 天",
        "note": "搭卑爾根鐵路與弗洛姆高山火車、渡輪穿越峽灣,兩端各留一至兩天逛奧斯陸歌劇院與卑爾根魚市。第一次到挪威、想一次收火車與峽灣的自由行首選。"
      },
      {
        "zh": "羅弗敦群島自駕",
        "days": "6–7 天",
        "note": "飛博多轉渡輪或飛斯沃爾維爾,租車沿 E10 公路串聯雷訥、漢姆諾、努斯峽灣,健行加漁村住宿。夏季永晝、冬季可追極光,拉車不多。"
      },
      {
        "zh": "特羅姆瑟極光與峽灣",
        "days": "5–6 天",
        "note": "以特羅姆瑟為基地,晚上追極光、白天賞鯨或去塞尼亞島兜風。城市餐廳與行程社密集,適合怕冷但想看極光的旅客。"
      },
      {
        "zh": "峽灣三重奏:蓋倫格—布道石—奇形巨石",
        "days": "8–10 天",
        "note": "從奧斯陸或卑爾根出發,自駕串聯蓋倫格峽灣、老鷹之路、布道石與呂瑟峽灣。體力好、假期長、想把經典健行一次走完的人適合。"
      },
      {
        "zh": "北角與芬馬克",
        "days": "5–6 天",
        "note": "飛阿爾塔或霍寧斯沃格,開車到歐洲大陸最北端北角看午夜太陽,沿途薩米文化與馴鹿。路遠、風大,適合想「走到盡頭」的旅客。"
      }
    ],
    "niche": [
      {
        "zh": "斯瓦爾巴群島(斯匹次卑爾根)",
