  "itineraries": {
    "hot": [
      {
        "zh": "文化三角＋高地茶園",
        "days": "7–8 天",
        "note": "尼甘布進,走獅子岩、丹布勒、康提佛牙寺,再搭山線火車到努瓦拉埃利亞與埃拉。台灣多經曼谷、新加坡或吉隆坡轉機。"
      },
      {
        "zh": "南部海岸＋加勒",
        "days": "5–6 天",
        "note": "可倫坡或加勒為據點,美蕊沙賞鯨、烏納瓦圖納浮潛、加勒古堡看夕陽,節奏悠閒。"
      },
      {
        "zh": "環島精華",
        "days": "10–12 天",
        "note": "文化三角、山區茶園、南部海岸與雅拉野生動物園一次走完,適合假期較長者。"
      },
      {
        "zh": "斯里蘭卡野生動物",
        "days": "5–6 天",
        "note": "以雅拉、烏達瓦拉威與辛哈拉賈雨林為主,找象群、豹與特有鳥類。"
      },
      {
        "zh": "可倫坡＋康提雙城",
        "days": "4–5 天",
        "note": "時間有限時,首都看市場與殖民建築,再上康提看佛牙寺與植物園。"
      }
    ],
    "niche": [
      {
        "zh": "賈夫納與北部",
        "note": "內戰後重新開放的北部坦米爾城市賈夫納,有印度教神廟、荷蘭堡與離島,遊客稀少。"
      },
      {
        "zh": "亞當峰朝聖",
        "note": "十二至五月夜間登亞當峰(聖足山),破曉看日出與三角形山影,是多宗教共同聖地。"
      },
      {
        "zh": "東岸亭可馬里",
        "note": "五至九月換東岸乾季,亭可馬里、尼拉維利海灘與鴿子島浮潛,人潮比西南岸少。"
      }
    ]
  },
