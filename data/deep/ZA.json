  "itineraries": {
    "hot": [
      {
        "zh": "開普敦與半島",
        "days": "4–5 天",
        "note": "台灣多經杜哈、香港或約翰尼斯堡轉機。市區走桌山、綠市廣場與波卡普區,一天沿海岸開到好望角與企鵝灘,一天跑康斯坦提亞或斯泰倫博斯酒莊。"
      },
      {
        "zh": "克留格爾遊獵",
        "days": "3–4 天",
        "note": "從約翰尼斯堡飛內爾斯普雷特或自駕進園,住公營營地或私人保護區,清晨與傍晚各一次 game drive。"
      },
      {
        "zh": "花園大道自駕",
        "days": "6–7 天",
        "note": "開普敦一路開到伊莉莎白港,經赫曼努斯賞鯨、奈斯納潟湖、齊齊卡馬吊橋與奧茨胡恩鴕鳥場。"
      },
      {
        "zh": "約堡＋普利托里亞歷史",
        "days": "2–3 天",
        "note": "參觀種族隔離博物館、憲政山與索威托,再到普利托里亞看聯合大廈,適合轉機或遊獵前後。"
      },
      {
        "zh": "全景之路與克留格爾",
        "days": "5 天",
        "note": "從約堡開上姆普馬蘭加高地,看上帝之窗、三茅屋與布萊德河峽谷,再下切進克留格爾北段。"
      }
    ],
    "niche": [
      {
        "zh": "龍山山脈健行",
        "note": "誇祖魯-納塔爾與賴索托交界的高山草原,有布須曼岩畫、瀑布與圓形劇場崖壁,適合多日健行。"
      },
      {
        "zh": "西北部喀拉哈里",
        "note": "到卡拉哈里跨境公園看沙丘、黑鬃獅與猛禽,路線偏遠、需四驅車與充足補給。"
      },
      {
        "zh": "誇祖魯-納塔爾戰場之旅",
        "note": "走訪伊散德爾瓦納與羅克渡口等英祖戰爭遺址,搭配當地說書導覽。"
      }
    ]
