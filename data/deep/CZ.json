  "itineraries": {
    "hot": [
      {
        "zh": "布拉格定點深度",
        "days": "4–5 天",
        "note": "老城廣場與天文鐘、查理大橋、城堡區與小城區、猶太區,傍晚聽一場古典音樂會。台灣多一次轉機可達,是第一次到中歐的自由行首選。"
      },
      {
        "zh": "布拉格＋庫倫洛夫＋庫特納霍拉",
        "days": "5–6 天",
        "note": "首都行程加上南波希米亞的中世紀小鎮庫倫洛夫住一晚,再去庫特納霍拉看人骨教堂與聖芭芭拉教堂。巴士與火車銜接方便。"
      },
      {
        "zh": "波希米亞溫泉與啤酒",
        "days": "5–6 天",
        "note": "卡羅維瓦利、瑪麗亞溫泉的溫泉迴廊,搭配皮爾森的啤酒廠導覽與百威城(České Budějovice)。適合想放鬆兼品飲的旅客。"
      },
      {
        "zh": "中歐四都串遊:布拉格—維也納—布達佩斯",
        "days": "8–10 天",
        "note": "以火車或巴士把三國首都串起來,布拉格與維也納間可順遊布爾諾或南摩拉維亞酒鄉。假期長、想一次玩多國的人適合。"
      }
    ],
    "niche": [
      {
        "zh": "摩拉維亞喀斯特與麥田曲線地景",
        "note": "布爾諾以北的鐘乳石洞與馬克赫拉深淵,搭配南摩拉維亞如波浪般起伏的葡萄園田景。班次少,自駕較方便。"
      },
      {
        "zh": "捷克瑞士國家公園",
        "note": "與德國交界的砂岩峰林,普拉夫奇采石門是最大的天然石拱。可從德勒斯登或布拉格一日往返。"
      },
      {
        "zh": "奧洛穆茨與北摩拉維亞",
        "note": "擁有世界遺產聖三柱與眾多噴泉的大學城,遊客遠少於布拉格,可延伸到普涅羅夫與貝斯基迪山。"
      }
    ]
  },
