  "itineraries": {
    "hot": [
      {
        "zh": "維也納＋薩爾茲堡＋哈爾施塔特",
        "days": "7–8 天",
        "note": "熊布朗宮、聖史蒂芬教堂與美術館,西行鹽湖區、哈爾施塔特湖畔小鎮與薩爾茲堡莫札特故居,聯邦鐵路串聯。第一次到奧地利、想一次收帝國古都與湖光山色的自由行首選。"
      },
      {
        "zh": "奧地利＋捷克:維也納—布拉格—庫倫洛夫",
        "days": "8–9 天",
        "note": "兩座中歐古都加波希米亞小鎮,巴士或火車約四小時互通。適合假期充足、想一次玩兩國的旅客。"
      },
      {
        "zh": "音樂與咖啡館的維也納定點",
        "days": "4–5 天",
        "note": "國家歌劇院或金色大廳聽一場、逛藝術史博物館與美景宮的克林姆,跑幾家百年咖啡館。適合愛古典樂與藝術、想慢慢玩一座城的旅客。"
      },
      {
        "zh": "提洛爾阿爾卑斯自駕",
        "days": "6–7 天",
        "note": "因斯布魯克金頂與跳台、大格洛克納高山公路、湖區與山中纜車。適合會開車、想看雪山冰河與高山公路的旅客,夏季通行。"
      },
      {
        "zh": "多瑙河瓦豪河谷＋維也納",
        "days": "5–6 天",
        "note": "梅爾克修道院、瓦豪河谷葡萄園單車或遊船、克雷姆斯小鎮,再回維也納。適合喜歡河谷田園、修道院與白酒的旅客。"
      }
    ],
    "niche": [
      {
        "zh": "施泰爾馬克南部葡萄酒之路",
        "note": "起伏的葡萄園、南瓜籽油與「施泰爾托斯卡尼」風光,格拉茲可作據點。需開車,淡季安靜。"
      },
      {
        "zh": "克恩頓湖區與山頂城堡",
        "note": "霍赫奧斯特維茨山頂城堡與沃特湖等溫暖湖泊,鄰近斯洛維尼亞,比提洛爾清靜。"
      },
      {
        "zh": "塞默靈鐵路景觀線",
        "note": "世界第一條山岳鐵路(列世界遺產),高架橋與隧道串連,可在車站之間健行。從維也納出發很方便。"
      }
    ]
