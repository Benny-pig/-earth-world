  "itineraries": {
    "hot": [
      {
        "zh": "聖地牙哥＋瓦爾帕萊索",
        "days": "4 天",
        "note": "台灣多經美國或聖保羅轉機。首都看武器廣場、聖克里斯托巴爾山,一天往返海港城瓦爾帕萊索與維尼亞德爾馬,再跑一趟邁波谷酒莊。"
      },
      {
        "zh": "阿他加馬沙漠",
        "days": "4–5 天",
        "note": "從卡拉馬機場進聖佩德羅,安排月亮谷、塔蒂奧噴泉、高原鹽湖與紅鶴保護區,並留一晚純觀星。"
      },
      {
        "zh": "百內國家公園 W 線",
        "days": "6–7 天",
        "note": "蓬塔阿雷納斯進、納塔萊斯港補給,五天走法國谷、英國人瞭望台與塔下三峰,住山屋或營地,可與阿根廷冰川行程串連。"
      },
      {
        "zh": "復活節島",
        "days": "4 天",
        "note": "從聖地牙哥飛五個半小時,環島看阿胡湯加里基十五尊摩艾、拉諾拉拉庫採石場與火山口,行程輕鬆適合搭配本島。"
      },
      {
        "zh": "湖區與奇洛埃島",
        "days": "6 天",
        "note": "從蒙特港租車,走瓦拉斯的奧索爾諾火山、彼得羅烏埃瀑布,再過渡輪到奇洛埃看木造教堂、吃庫蘭托。"
      }
    ],
    "niche": [
      {
        "zh": "卡雷拉將軍湖與南部公路",
        "note": "沿七號公路自駕,看大理石教堂、翡翠色湖水與貝克河,路況粗獷、補給點少。"
