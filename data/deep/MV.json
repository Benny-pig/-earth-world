  "itineraries": {
    "hot": [
      {
        "zh": "度假村蜜月／放空",
        "days": "5–6 天",
        "note": "選一座水上屋度假村,以浮潛、SPA 與跳島半日遊為主。台灣多經新加坡、吉隆坡或曼谷轉機到馬列,再轉快艇或水上飛機。"
      },
      {
        "zh": "潛水船宿(liveaboard)",
