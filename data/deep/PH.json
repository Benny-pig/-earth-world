  "itineraries": {
    "hot": [
      {
        "zh": "宿霧＋薄荷島跳島",
        "days": "5–6 天",
        "note": "宿霧看鯨鯊、下潛沙丁魚風暴或跳瀑布,轉往薄荷島看眼鏡猴、巧克力山與羅博河遊船。台灣有直飛航班,行程機動,適合第一次到菲律賓、想一次玩到海島與野生動物的家庭與情侶。"
      },
      {
        "zh": "巴拉望愛妮島跳島",
        "days": "6–7 天",
        "note": "從公主港或愛妮島出發,搭船遊大小礁湖、跳島浮潛,再看普林塞薩港地下河。旺季在乾季十一至五月,適合想拍潟湖美景、玩水的旅客。"
      },
      {
        "zh": "長灘島度假",
        "days": "4–5 天",
        "note": "以白沙灘為核心,玩水上活動、看日落帆船,島小步行可達。適合只想曬太陽耍廢、預算彈性的年輕族群,旺季房價漲幅大。"
      },
      {
        "zh": "馬尼拉＋八打雁潛水",
        "days": "5 天",
        "note": "馬尼拉逛王城區、大教堂與博物館,再到阿尼洛或八打雁玩微距潛水與浮潛。適合時間有限、想都會加潛水一次滿足的旅客。"
      },
      {
        "zh": "科隆沉船潛水",
        "days": "5–6 天",
        "note": "科隆鎮出發,潛二戰沉船群、雙湖與熱門浮潛點,水面景色也秀麗。適合已有潛水證、專程玩沉船的進階玩家。"
      }
    ],
    "niche": [
      {
        "zh": "呂宋北部梯田健行",
        "note": "從巴拿威走到巴達德,住伊富高族村落,綠意最盛在六到七月。山路彎多、班次稀少,建議包車並多留緩衝時間。"
      },
      {
        "zh": "錫亞高衝浪島",
        "note": "以「雲九」浪點與潟湖跳島聞名,近年才熱門。雨季風浪大,颱風季要緊盯氣象,住宿旺季常客滿。"
      },
      {
        "zh": "卡米金島火山小島",
        "note": "七座火山構成的小島,有水下十字架、白沙洲與溫泉瀑布,遊客稀少。需經卡加延德奧羅轉機或搭船,班次有限。"
      }
    ]
