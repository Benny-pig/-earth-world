  "itineraries": {
    "hot": [
      {
        "zh": "布萊德＋盧比安納＋波斯托伊納",
        "days": "5–6 天",
        "note": "布萊德湖與博興湖兩天、盧比安納老城與城堡一天,再走波斯托伊納洞與普雷德亞馬城堡。台灣經維也納、法蘭克福或伊斯坦堡轉機,是第一次到斯洛維尼亞的標準路線。"
      },
      {
        "zh": "盧比安納＋皮蘭＋喀斯特",
        "days": "5–6 天",
        "note": "首都接海邊皮蘭、波爾托羅日,穿插利皮察馬場與什科茨揚洞世界遺產。海岸加地下奇景,步調悠閒。"
      },
      {
        "zh": "斯洛維尼亞＋克羅埃西亞",
        "days": "7–8 天",
        "note": "盧比安納—布萊德—普利特維采湖—札格雷布一路南下,一趟收兩國精華,自駕最順。"
      },
      {
        "zh": "朱利安阿爾卑斯山環線",
        "days": "5–6 天",
        "note": "布萊德、博興、弗爾希奇山口到索查河谷,健行、泛舟與一戰博物館。夏季前往、山路彎多。"
      },
      {
        "zh": "盧比安納定點城市假期",
        "days": "3–4 天",
        "note": "以首都為據點,白天走老城、龍橋與中央市場,搭配布萊德或波斯托伊納一日團,適合週末長假。"
      }
    ],
