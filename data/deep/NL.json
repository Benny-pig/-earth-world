  "itineraries": {
    "hot": [
      {
        "zh": "阿姆斯特丹深度＋風車村",
        "days": "4–5 天",
        "note": "國家博物館、梵谷美術館、安妮之家與運河遊船,再一天到桑斯安斯風車村或羊角村。定點玩透一座城、拉車少,是第一次到荷蘭的自由行首選。"
      },
      {
        "zh": "荷蘭經典環線:阿姆斯特丹—海牙—台夫特—鹿特丹",
        "days": "6–7 天",
        "note": "加上小孩堤防風車、海牙莫瑞泰斯美術館與鹿特丹的現代建築與市場廳,城際火車班次密。適合想一次看齊古典與現代荷蘭的旅客。"
      },
      {
        "zh": "春季鬱金香花季",
        "days": "4–5 天",
        "note": "三月中至五月中,庫肯霍夫花園、麗絲球根花田騎車、阿克馬乳酪市集。專程賞花拍照,務必先買門票並避開週末人潮。"
      },
      {
        "zh": "荷比盧三國",
        "days": "8–10 天",
        "note": "阿姆斯特丹、布魯塞爾、布魯日、盧森堡市,火車一兩小時互通。適合假期較長、想一次收三國精華的旅客。"
      },
      {
        "zh": "荷蘭北部與瓦登海",
        "days": "5–6 天",
        "note": "阿夫魯戴克攔海大壩、菲仕蘭省的馬與湖區,搭船登特塞爾島賞海豹。適合喜歡自然、水利工程與離島步調的旅客。"
      }
    ],
    "niche": [
      {
        "zh": "羊角村與東北田園",
        "note": "沒有汽車、只能撐船或騎車的「綠色威尼斯」,茅草屋倒映水道。中午一日遊人潮多,最好住一晚或一早前往。"
      },
      {
        "zh": "澤蘭省三角洲工程",
        "note": "看「三角洲工程」的防潮閘與人工島尼爾傑揚斯,順遊蚵鎮與貝類餐廳。需開車,海邊風大。"
      },
      {
        "zh": "馬斯垂克與南林堡丘陵",
        "note": "荷蘭少見的丘陵地帶,有洞穴、弗萊特廣場與跨境氛圍,適合騎車與逛市集,感覺不太「荷蘭」。"
      }
    ]
  },
