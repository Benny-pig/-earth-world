  "itineraries": {
    "hot": [
      {
        "zh": "哥本哈根定點深度",
        "days": "4–5 天",
        "note": "新港、蒂沃利、圓塔、克里斯欽自由城與設計博物館,一天往返羅斯基勒維京船博物館。航班選擇多、市內單車友善,適合週末小旅行。"
      },
      {
        "zh": "哥本哈根＋北西蘭城堡群",
        "days": "5–6 天",
        "note": "首都行程加上腓特烈堡宮、克倫堡宮與現代藝術館 Louisiana,搭區間車一日可達。適合愛城堡與美術館的旅客。"
      },
      {
        "zh": "日德蘭半島自駕(奧胡斯—里伯—比隆)",
        "days": "6–7 天",
        "note": "丹麥第二大城奧胡斯的老鎮露天博物館、最古老城鎮里伯、比隆樂高樂園,再到瓦登海看候鳥。適合親子與自駕客。"
      },
      {
        "zh": "哥本哈根＋馬爾默一日跨國",
        "days": "4–5 天",
        "note": "以哥本哈根為主,搭火車過厄勒海峽大橋到瑞典馬爾默半日遊。適合想順帶踏進瑞典的旅客。"
      },
      {
        "zh": "歐登賽與菲因島",
        "days": "4–5 天",
        "note": "安徒生故鄉歐登賽的童話步道,加上埃格斯考城堡與海邊小鎮,節奏緩慢適合慢遊。"
      }
    ],
    "niche": [
