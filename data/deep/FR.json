  "itineraries": {
    "hot": [
      {
        "zh": "巴黎與近郊:巴黎—凡爾賽—吉維尼",
        "days": "5–7 天",
        "note": "羅浮宮、奧塞、鐵塔與塞納河遊船,再排凡爾賽宮與莫內花園各一天。適合第一次到法國、想把經典地標與美術館一次看足的自由行。"
      },
      {
        "zh": "巴黎加羅亞爾河城堡:巴黎—奧爾良—香波堡—雪儂梭堡—圖爾",
        "days": "7–9 天",
        "note": "巴黎主軸再加三到四天城堡巡禮,文藝復興宮殿、葡萄酒莊與河谷小鎮。城堡段大眾運輸不便,建議搭配一日遊或租車,適合喜歡歷史建築與慢步調的旅客。"
      },
      {
        "zh": "南法普羅旺斯與蔚藍海岸:亞維儂—亞爾—尼斯—坎城—摩納哥",
        "days": "8–10 天",
        "note": "薰衣草田(六到七月)、梵谷的亞爾、蔚藍海岸的海灣與遊艇港,TGV 從巴黎南下再租車。適合愛陽光、海景與鄉村市集的旅客。"
      },
      {
        "zh": "阿爾薩斯童話小鎮:史特拉斯堡—科爾馬—酒鄉之路",
        "days": "4–6 天",
        "note": "半木造彩色房屋、小法國運河區,沿葡萄酒之路串聯里克維爾等童話村莊,聖誕市集季更夢幻。適合想拍小鎮、喝白酒的情侶與家庭。"
      },
      {
