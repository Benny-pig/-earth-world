  "itineraries": {
    "hot": [
      {
        "zh": "外西凡尼亞古城與城堡環線",
        "days": "6–7 天",
        "note": "布加勒斯特進出,自駕或跟團串聯錫納亞佩雷什城堡、布蘭城堡、布拉索夫、錫吉什瓦拉與錫比烏。第一次到羅馬尼亞、想一次收城堡與薩克森古城的首選。"
      },
      {
        "zh": "布加勒斯特＋錫納亞山城",
        "days": "4–5 天",
        "note": "首都的議會宮、老城與村莊博物館,搭火車一小時到錫納亞看佩雷什城堡與登山纜車。適合天數少的旅客。"
      },
      {
        "zh": "布科維納彩繪修道院",
        "days": "4–5 天",
        "note": "以蘇恰瓦為基地,走訪沃羅內茨、莫爾多維察與蘇切維察等外牆彩繪的世界遺產修道院,搭配木造教堂。適合愛宗教藝術的旅客。"
      },
      {
        "zh": "喀爾巴阡自駕:橫貫公路與畢卡茲峽谷",
        "days": "7–8 天",
        "note": "夏季走川法加拉與川阿爾卑斯山公路,加畢卡茲峽谷與紅湖、錫比烏周邊。彎道多、僅盛夏全開,適合自駕與山景愛好者。"
      },
      {
        "zh": "多瑙河三角洲生態",
        "days": "4–5 天",
        "note": "圖爾恰搭船進蘇利納或穆爾吉霍爾的水道民宿,清晨賞鳥、釣魚、看漁村。適合想避開人潮、親近自然的旅客。"
      }
    ],
    "niche": [
      {
        "zh": "馬拉穆列什木教堂與農村",
        "note": "羅馬尼亞北部保留高聳木造教堂與傳統木門的地區,「歡樂墓園」以彩繪墓碑聞名,自駕較方便。"
      },
      {
        "zh": "多瑙河鐵門峽谷",
        "note": "多瑙河切穿喀爾巴阡山的壯麗峽谷,河岸有巨大的達契亞王岩雕,可搭船遊覽。"
      },
      {
        "zh": "阿普塞尼山與圖爾達鹽礦",
        "note": "外西凡尼亞西部的喀斯特山區,冰洞與峽谷,搭配改成地下遊樂場的圖爾達鹽礦。"
      }
    ]
