  "itineraries": {
    "hot": [
      {
        "zh": "汶萊城市＋雨林",
        "days": "3–4 天",
        "note": "斯里巴加灣看清真寺、水村與夜市,加一天烏魯淡武廊雨林。台灣可經新加坡、吉隆坡或馬尼拉轉機,適合週末或連假。"
      },
      {
        "zh": "汶萊＋沙巴",
        "days": "6–7 天",
        "note": "汶萊兩天後,陸路或搭機到沙巴亞庇,接神山、海島與長鼻猴,一趟看婆羅洲北部。"
      },
      {
        "zh": "汶萊＋美里(砂拉越)",
        "days": "4–5 天",
        "note": "從汶萊陸路到砂拉越的美里,看尼亞洞與姆祿國家公園的鐘乳石與蝙蝠洞。"
      },
      {
        "zh": "汶萊過境深度遊",
        "days": "2–3 天",
        "note": "利用皇家汶萊航空的過境行程,集中看清真寺、博物館、水村與一場雨林半日團。"
      }
    ],
    "niche": [
      {
        "zh": "淡武廊區慢遊",
        "note": "被砂拉越隔開的東部飛地,除國家公園外還有農莊、溪流與寧靜村落,適合放空。"
      },
      {
        "zh": "詩里亞油田與海濱",
        "note": "看「十億桶」紀念碑、油氣探索館與海邊抽油機,了解汶萊的經濟命脈。"
      },
      {
        "zh": "內陸長屋體驗",
        "note": "淡武廊或白拉奕內陸的伊班族長屋聚落,體驗傳統共居生活,需事先安排。"
      }
    ]
