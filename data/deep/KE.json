  "itineraries": {
    "hot": [
      {
        "zh": "馬賽馬拉遊獵",
        "days": "3–4 天",
        "note": "台灣多經曼谷、杜哈或阿迪斯阿貝巴轉機到內羅畢,再搭輕型飛機進馬拉,每天早晚各一次 game drive,旺季務必早訂。"
      },
      {
        "zh": "肯亞經典環線",
        "days": "7–9 天",
        "note": "內羅畢出發,串連安波塞利、奈瓦夏湖、納庫魯湖與馬賽馬拉,多為四驅車陸路移動,路況顛簸。"
      },
      {
        "zh": "遊獵＋印度洋海岸",
        "days": "8–10 天",
        "note": "前段內陸遊獵,後段飛蒙巴薩或迪亞尼,拉穆看古城、海邊住民宿,行程張弛有度。"
      },
      {
        "zh": "內羅畢周邊",
        "days": "2–3 天",
        "note": "適合轉機停留,看長頸鹿中心、大象孤兒院與內羅畢國家公園,再逛卡倫故居與市集。"
      },
      {
        "zh": "安波塞利＋察沃",
        "days": "4–5 天",
        "note": "從內羅畢南下,先安波塞利拍雪山大象,再進東西察沃看紅土象群與辛巴丘,適合第二次來的旅客。"
      }
    ],
    "niche": [
      {
        "zh": "圖爾卡納湖與北部邊疆",
        "note": "「翡翠海」般的鹼水湖與化石遺址,路途遙遠、需嚮導與補給,可搭配部落文化節。"
      },
      {
        "zh": "肯亞山攀登",
